<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tech_category_list" model="ir.ui.view">
        <field name="name">tech.category.list</field>
        <field name="model">tech.category</field>
        <field name="arch" type="xml">
            <list string="Categorías de Equipos">
                <field name="name"/>
                <field name="description"/>
                <field name="equipment_count" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_tech_category_form" model="ir.ui.view">
        <field name="name">tech.category.form</field>
        <field name="model">tech.category</field>
        <field name="arch" type="xml">
            <form string="Categoría">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la categoría..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="description" placeholder="Descripción detallada..."/>
                        <field name="equipment_count"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tech_category" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">tech.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Gestiona las categorías de tus equipos tecnológicos!
            </p>
        </field>
    </record>
</odoo>
